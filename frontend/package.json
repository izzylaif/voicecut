{
  "name": "voicecut-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoiceCut correction editor: timeline, preview and export over the original recording",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
