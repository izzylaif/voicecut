{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "voicecut",
  "bundle": {
    "targets": ["appimage", "deb"],
    "resources": {
      "../build/runtime/": "runtime/",
      "icons/VoiceCutDocument.icns": null,
      "../linux/voicecut-mime.xml": "linux/voicecut-mime.xml",
      "icons/128x128@2x.png": "linux/voicecut.png",
      "icons/VoiceCutDocument.png": "linux/application-x-voicecut-project.png"
    },
    "fileAssociations": [
      {
        "ext": ["vcproj"],
        "name": "VoiceCut Project",
        "description": "VoiceCut Project",
        "role": "Editor",
        "mimeType": "application/x-voicecut-project"
      }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "video",
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"],
        "desktopTemplate": "../linux/voicecut.desktop",
        "files": {
          "/usr/share/mime/packages/voicecut.xml": "../linux/voicecut-mime.xml",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-voicecut-project.png": "icons/VoiceCutDocument.png"
        }
      }
    }
  }
}
